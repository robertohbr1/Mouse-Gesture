<Window x:Class="MouseKeyb.ButtonConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Botão" 
        Height="280" Width="420"
        Background="#16161A" Foreground="#FFFFFF"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderBrush="#FF00D2FF" BorderThickness="1.5">
    <Window.Resources>
        <!-- Custom text box style -->
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#22222A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33333F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FF00D2FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Buttons style -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF00D2FF" Offset="0"/>
                        <GradientStop Color="#FF0072FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="#E1E1E6"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Configurar Botão do Menu" FontSize="18" FontWeight="Bold" Foreground="#FF00D2FF" Margin="0,0,0,15"/>
        
        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Texto do Botão (Caption):" Margin="0,0,0,5" Foreground="#8F8F9D"/>
            <TextBox x:Name="CaptionTextBox" Style="{StaticResource DialogTextBoxStyle}" Margin="0,0,0,15"/>
            
            <TextBlock Text="Programa a Executar:" Margin="0,0,0,5" Foreground="#8F8F9D"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProgramTextBox" Style="{StaticResource DialogTextBoxStyle}" Grid.Column="0" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="..." Style="{StaticResource DialogSecondaryButtonStyle}" Width="35" Click="BrowseButton_Click"/>
            </Grid>
        </StackPanel>
        
        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Salvar" Style="{StaticResource DialogButtonStyle}" Click="SaveButton_Click" Margin="0,0,10,0"/>
            <Button Content="Cancelar" Style="{StaticResource DialogSecondaryButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
