<Window x:Class="MouseKeyb.CircularMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CircularMenu" 
        Height="400" Width="400"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">
    <Grid>
        <Ellipse Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <ImageBrush ImageSource="pack://application:,,,/menu.jpg" Stretch="UniformToFill"/>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Round N++ Button in the center hole of the lego donut -->
        <Button Width="110" Height="110" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="0,0,0,121"
                Cursor="Hand"
                Click="Button_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonGrid">
                        <!-- Outer glow / border -->
                        <Ellipse x:Name="OuterGlow" Fill="#1A000000" Stroke="#40FFFFFF" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF00D2FF" BlurRadius="10" ShadowDepth="0" Opacity="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Button base -->
                        <Ellipse x:Name="BaseEllipse" Margin="2">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2C3E50" Offset="0"/>
                                    <GradientStop Color="#000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Content -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BaseEllipse" Property="Fill">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#34495E" Offset="0"/>
                                        <GradientStop Color="#1A1A1A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="OuterGlow" Property="Stroke" Value="#FF00D2FF"/>
                            <Setter TargetName="OuterGlow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF00D2FF" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonGrid" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="55" CenterY="55"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="N++" Foreground="White" FontSize="22" FontWeight="Bold" FontFamily="Segoe UI"/>
        </Button>
    </Grid>
</Window>
