<Window x:Class="MouseKeyb.CommandListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MouseKeyb"
        Title="Lista de Comandos" 
        Height="400" Width="450"
        Background="#16161A" Foreground="#FFFFFF"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderBrush="#FF00D2FF" BorderThickness="1.5"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Custom Item Button Style -->
        <Style x:Key="CommandListItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C1C22"/>
            <Setter Property="BorderBrush" Value="#2D2D38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#25252D"/>
                    <Setter Property="BorderBrush" Value="#FF00D2FF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#16161A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style (like Close) -->
        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="#E1E1E6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Lista de Comandos Disponíveis" FontSize="18" FontWeight="Bold" Foreground="#FF00D2FF" Margin="0,0,0,15"/>
        
        <!-- Scrollable Command List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,10">
            <ItemsControl x:Name="CommandItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:GestureMapping}">
                        <Button Style="{StaticResource CommandListItemButtonStyle}" Click="CommandItem_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ActionName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#22222A" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Pattern}" Foreground="#FF00D2FF" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Fechar" Style="{StaticResource DialogSecondaryButtonStyle}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
